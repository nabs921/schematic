# =========================================================
# SQL Schema Designer Environment Variables
# =========================================================

# PostgreSQL: local server only. Start the bundled database with:
#   docker compose up -d
# Then run migrations with `pnpm run db:migrate`.
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/schematic"

# App base URL
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# Self-hosted Yjs collaboration server (run alongside the web app)
COLLAB_HOST="0.0.0.0"
COLLAB_PORT="1234"
# Optional: browser-facing WebSocket URL. Leave unset to connect to port 1234
# on the same host that serves the app, e.g. ws://localhost:1234.
# NEXT_PUBLIC_COLLAB_WS_URL="ws://localhost:1234"

# Optional: shared secret used by the app to call the collaboration server's
# /kick and /allow control endpoints. When unset, only loopback requests are
# accepted, which is suitable for local development.
# COLLAB_CONTROL_SECRET="change-me"
# Optional: HTTP URL of the control server when it is not localhost:1234.
# COLLAB_CONTROL_URL="http://127.0.0.1:1234"
# Optional: how long a removed collaborator is blocked from reconnecting.
# Defaults to 24 hours.
# COLLAB_REVOKE_TTL_MS="86400000"
