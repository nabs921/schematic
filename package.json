{
  "name": "schematic",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "concurrently --kill-others-on-fail --names web,collab -c blue,magenta \"next dev\" \"node scripts/collab-server.mjs\"",
    "dev:web": "next dev",
    "dev:collab": "node scripts/collab-server.mjs",
    "build": "next build",
    "start": "concurrently --kill-others-on-fail --names web,collab -c blue,magenta \"next start\" \"node scripts/collab-server.mjs\"",
    "start:web": "next start",
    "start:collab": "node scripts/collab-server.mjs",
    "lint": "eslint",
    "db:migrate": "tsx --env-file=.env scripts/migrate.ts",
    "test:all": "tsx --env-file=.env scripts/test-all.ts"
  },
